#!/usr/bin/env bash
set -euo pipefail

import_graphical_environment() {
  local -a variables=()
  local variable unit

  for variable in DISPLAY XAUTHORITY; do
    if [ -n "${!variable:-}" ]; then
      variables+=("$variable")
    fi
  done

  if [ "${#variables[@]}" -eq 0 ]; then
    return 0
  fi

  systemctl --user import-environment "${variables[@]}"
  dbus-update-activation-environment --systemd "${variables[@]}"

  # LightDM starts the user manager before the X11 session variables exist.
  # Recover only the graphical services that may have raced that import.
  for unit in xfce4-notifyd.service xdg-desktop-portal-gtk.service; do
    if ! systemctl --user is-active --quiet "$unit"; then
      systemctl --user reset-failed "$unit" || true
      systemctl --user start "$unit"
    fi
  done
}

import_graphical_environment

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/lyra-os"
marker="$state_dir/xfce-defaults-applied"
wallpaper="/usr/share/backgrounds/lyra/2702-dawn.png"
menu_icon="/usr/share/icons/hicolor/scalable/apps/lyra-launcher.svg"

if [ -e "$marker" ]; then
  exit 0
fi

# Fixe o arquivo exato do Lyra no botão do Whisker. Usar apenas o nome do
# ícone deixa a escolha sujeita ao tema/cache da sessão.
for menu_config in "${XDG_CONFIG_HOME:-$HOME/.config}"/xfce4/panel/whiskermenu-*.rc; do
  [ -f "$menu_config" ] || continue
  if grep -q '^button-icon=' "$menu_config"; then
    sed -i "s|^button-icon=.*|button-icon=$menu_icon|" "$menu_config"
  else
    printf 'button-icon=%s\n' "$menu_icon" >> "$menu_config"
  fi
done

for _ in {1..20}; do
  mapfile -t wallpaper_properties < <(
    xfconf-query -c xfce4-desktop -l 2>/dev/null |
      grep -E '/(last-image|image-path)$' || true
  )
  if [ "${#wallpaper_properties[@]}" -gt 0 ]; then
    for property in "${wallpaper_properties[@]}"; do
      xfconf-query -c xfce4-desktop -p "$property" -s "$wallpaper"
    done
    mkdir -p "$state_dir"
    : > "$marker"
    exit 0
  fi
  sleep 0.5
done

exit 1
