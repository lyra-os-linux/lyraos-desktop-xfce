#!/usr/bin/python3
"""Validate an installed Lyra system and produce release-gate evidence."""

from __future__ import annotations

import argparse
import datetime as dt
import getpass
import json
import os
import subprocess
import tempfile
from pathlib import Path
from typing import Callable


CommandRunner = Callable[[list[str]], tuple[int, str]]

LIVE_ONLY_PATHS = (
    "/etc/lightdm/lightdm.conf.d/50-lyra-live.conf",
    "/etc/xdg/autostart/lyra-installer-autostart.desktop",
    "/usr/bin/lyra-install-lock",
    "/usr/bin/lyra-installer",
    "/usr/bin/lyra-live-smoke",
    "/usr/libexec/lyra-installer-service",
    "/usr/libexec/lyra-configure-btrfs-rollback",
    "/usr/share/applications/org.lyraos.LyraInstaller.desktop",
    "/usr/share/polkit-1/actions/io.lyra.Installer.policy",
    "/etc/polkit-1/rules.d/01-lyra-installer-service.rules",
    "/usr/lib/lyra-os/local-installer-build",
)

# Mirrors scripts/server-install.sh's own "strip live-only artifacts" step
# (docs/server-edition.md) - the server profile has none of the desktop
# installer's files to begin with, so its live-only set is unrelated:
# console autologin and the pinned installer script itself.
SERVER_LIVE_ONLY_PATHS = (
    "/etc/systemd/system/getty@tty1.service.d/override.conf",
    "/root/.bash_profile",
    "/usr/sbin/lyra-server-install",
)

# Desktop expects Btrfs+Snapper; the server profile's v1 installer uses
# plain ext4 with no rollback (docs/server-edition.md - deliberately out of
# scope without an entry criterion for a v2).
EXPECTED_ROOT_FSTYPE = {"desktop": "btrfs", "server": "ext4"}

# Desktop-only units (display manager, cups) vs the persistent services the
# server's console installer enables. vegad is deliberately absent: it is a static
# D-Bus-activated unit which exits after its idle timeout.
EXPECTED_ACTIVE_UNITS = {
    "desktop": (
        "graphical.target",
        "display-manager.service",
        "NetworkManager.service",
        "firewalld.service",
        "cups.service",
        "btrfs-scrub.timer",
    ),
    "server": (
        "NetworkManager.service",
        "firewalld.service",
        "sshd.service",
        "vega-web.service",
    ),
}

EXPECTED_DISABLED_UNITS = {
    "desktop": (
        "btrfs-balance.timer",
        "btrfs-defrag.timer",
        "btrfs-trim.timer",
    ),
    "server": (),
}


def run_command(arguments: list[str]) -> tuple[int, str]:
    try:
        completed = subprocess.run(
            arguments,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=60,
            env={**os.environ, "LC_ALL": "C"},
        )
    except subprocess.TimeoutExpired as error:
        return 124, f"command timed out after {error.timeout} seconds"
    except OSError as error:
        return 127, str(error)
    return completed.returncode, completed.stdout.strip()


def rooted(root: Path, absolute: str) -> Path:
    return root / absolute.removeprefix("/")


def privileged_command(
    arguments: list[str], *, runner: CommandRunner, required: bool
) -> tuple[int, str]:
    if not required:
        return runner(arguments)
    return runner(["sudo", "-n", "--", *arguments])


def read_system_text(
    path: Path, *, runner: CommandRunner, privileged_fallback: bool
) -> tuple[int, str]:
    if not path.is_file():
        return 1, f"missing file: {path}"
    try:
        return 0, path.read_text(encoding="utf-8", errors="replace")
    except OSError as error:
        if not privileged_fallback:
            return 1, str(error)
        code, output = privileged_command(
            ["cat", str(path)], runner=runner, required=True
        )
        return code, output or str(error)


def probe_system_path(
    path: Path,
    *,
    kind: str,
    runner: CommandRunner,
    privileged_fallback: bool,
) -> tuple[bool, str]:
    predicates = {
        "exists": (path.exists, "-e"),
        "file": (path.is_file, "-f"),
        "directory": (path.is_dir, "-d"),
    }
    if kind not in predicates:
        raise ValueError(f"unsupported path probe kind: {kind!r}")
    predicate, test_flag = predicates[kind]
    try:
        return predicate(), ""
    except OSError as error:
        if not privileged_fallback:
            return False, str(error)
        code, output = privileged_command(
            ["test", test_flag, str(path)], runner=runner, required=True
        )
        if code == 0:
            return True, ""
        if code == 1 and not output:
            privilege_code, privilege_output = privileged_command(
                ["true"], runner=runner, required=True
            )
            if privilege_code == 0:
                return False, ""
            return False, privilege_output or "privileged path probe failed"
        return False, output or str(error)


def result(
    mode: str,
    checks: list[dict[str, str]],
    observations: dict[str, object],
) -> dict[str, object]:
    passed = all(item["status"] == "passed" for item in checks)
    return {
        "schema": 1,
        "status": "passed" if passed else "failed",
        "mode": mode,
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "checks": checks,
        "observations": observations,
    }


def validate_first_boot(
    *,
    root: Path = Path("/"),
    username: str | None = None,
    environment: dict[str, str] | None = None,
    runner: CommandRunner = run_command,
    journal_acknowledgement: str = "",
    profile: str = "desktop",
) -> dict[str, object]:
    if profile not in EXPECTED_ROOT_FSTYPE:
        raise ValueError(f"profile must be one of {sorted(EXPECTED_ROOT_FSTYPE)}, got {profile!r}")
    username = username or getpass.getuser()
    environment = environment or dict(os.environ)
    checks: list[dict[str, str]] = []
    observations: dict[str, object] = {}
    privileged_access_required = root.resolve() == Path("/")

    def check(identifier: str, passed: bool, detail: str) -> None:
        checks.append(
            {
                "id": identifier,
                "status": "passed" if passed else "failed",
                "detail": detail,
            }
        )

    if privileged_access_required:
        code, privilege_output = privileged_command(
            ["true"], runner=runner, required=True
        )
        check(
            "privileged-read-access",
            code == 0,
            "sudo credential is available"
            if code == 0
            else privilege_output or "run sudo -v before collecting evidence",
        )
    else:
        check(
            "privileged-read-access",
            True,
            "alternate root fixture does not require sudo",
        )

    for path in ("/usr/lib/lyra-os/release", "/usr/lib/lyra-os/build-info"):
        check(
            f"identity-{Path(path).name}",
            rooted(root, path).is_file(),
            f"{path} exists",
        )

    machine_id = rooted(root, "/etc/machine-id")
    machine_id_value = (
        machine_id.read_text(encoding="utf-8").strip()
        if machine_id.is_file()
        else ""
    )
    valid_machine_id = len(machine_id_value) == 32 and all(
        character in "0123456789abcdef" for character in machine_id_value.lower()
    )
    check(
        "machine-id",
        valid_machine_id,
        "installed system has a persistent machine identity",
    )

    check(
        "installed-user",
        username not in {"root", "liveuser"},
        f"current user: {username}",
    )
    code, user_entry = runner(["getent", "passwd", username])
    check(
        "installed-user-account",
        code == 0 and bool(user_entry),
        "created account is resolvable",
    )
    account_fields = user_entry.split(":") if code == 0 else []
    if len(account_fields) == 7:
        account_uid, account_gid, account_home = (
            account_fields[2],
            account_fields[3],
            account_fields[5],
        )
        home_path = rooted(root, account_home)
        stat_code, home_metadata = runner(
            ["stat", "--format=%u:%g:%a", str(home_path)]
        )
        metadata_fields = home_metadata.split(":")
        home_owned = (
            stat_code == 0
            and len(metadata_fields) == 3
            and metadata_fields[:2] == [account_uid, account_gid]
        )
        owner_writable = (
            home_owned
            and metadata_fields[2].isdigit()
            and bool(int(metadata_fields[2][0]) & 2)
        )
        check(
            "installed-user-home-ownership",
            home_owned,
            f"home metadata: {home_metadata or 'unavailable'}; expected owner {account_uid}:{account_gid}",
        )
        check(
            "installed-user-home-writable",
            owner_writable,
            "home owner has write permission"
            if owner_writable
            else f"home is not writable by its owner: {home_metadata or 'unavailable'}",
        )
    else:
        check(
            "installed-user-home-ownership",
            False,
            "created account entry is malformed",
        )
        check(
            "installed-user-home-writable",
            False,
            "created account home cannot be validated",
        )
    code, live_user = runner(["getent", "passwd", "liveuser"])
    check("live-user-removed", code != 0 and not live_user, "liveuser is absent")

    live_only_paths = LIVE_ONLY_PATHS if profile == "desktop" else SERVER_LIVE_ONLY_PATHS
    remaining: list[str] = []
    probe_errors: list[str] = []
    for path in live_only_paths:
        exists, error = probe_system_path(
            rooted(root, path),
            kind="exists",
            runner=runner,
            privileged_fallback=privileged_access_required,
        )
        if exists:
            remaining.append(path)
        elif error:
            probe_errors.append(f"{path}: {error}")
    check(
        "live-artifacts-removed",
        not remaining and not probe_errors,
        "none remain"
        if not remaining and not probe_errors
        else "; ".join([*remaining, *probe_errors]),
    )
    code, package_output = runner(
        ["rpm", "--root", str(root), "-q", "lyra-installer"]
    )
    check(
        "installer-package-removed",
        code != 0,
        package_output or "lyra-installer is absent from the target RPM database",
    )

    live_rootfs, live_rootfs_error = probe_system_path(
        rooted(root, "/run/overlay/live/LiveOS/squashfs.img"),
        kind="exists",
        runner=runner,
        privileged_fallback=privileged_access_required,
    )
    check(
        "not-live-rootfs",
        not live_rootfs and not live_rootfs_error,
        live_rootfs_error
        or (
            "live squashfs is still mounted"
            if live_rootfs
            else "live squashfs is not mounted"
        ),
    )
    expected_fstype = EXPECTED_ROOT_FSTYPE[profile]
    code, root_fstype = runner(["findmnt", "-n", "-o", "FSTYPE", "/"])
    check(
        "root-filesystem",
        code == 0 and root_fstype == expected_fstype,
        f"root filesystem: {root_fstype or 'unknown'} (expected {expected_fstype})",
    )
    code, efi_mount = runner(["findmnt", "-n", "/boot/efi"])
    check(
        "efi-mounted",
        code == 0 and bool(efi_mount),
        efi_mount or "/boot/efi is not mounted",
    )
    code, fstab_output = privileged_command(
        ["findmnt", "--verify", "--tab-file", "/etc/fstab"],
        runner=runner,
        required=privileged_access_required,
    )
    check("fstab-valid", code == 0, fstab_output or "fstab verified")

    grub = rooted(root, "/boot/grub2/grub.cfg")
    grub_code, grub_content = read_system_text(
        grub,
        runner=runner,
        privileged_fallback=privileged_access_required,
    )
    check(
        "grub-config",
        grub_code == 0 and "menuentry " in grub_content,
        "/boot/grub2/grub.cfg contains boot entries"
        if grub_code == 0 and "menuentry " in grub_content
        else grub_content or "/boot/grub2/grub.cfg is unreadable",
    )
    if profile == "desktop":
        # Snapper/rollback is desktop-only (docs/server-edition.md); the
        # server's ext4 root has no snapshot concept to check.
        code, snapshots = privileged_command(
            ["snapper", "--no-dbus", "-c", "root", "list"],
            runner=runner,
            required=privileged_access_required,
        )
        check(
            "snapper-root",
            code == 0 and bool(snapshots),
            snapshots or "root snapshots unavailable",
        )

    for unit in EXPECTED_ACTIVE_UNITS[profile]:
        code, output = runner(["systemctl", "is-active", unit])
        check(
            f"unit-{unit}",
            code == 0 and output == "active",
            f"state: {output or 'unknown'}",
        )

    for unit in EXPECTED_DISABLED_UNITS[profile]:
        code, output = runner(["systemctl", "is-enabled", unit])
        check(
            f"unit-{unit}-disabled",
            code != 0 and output == "disabled",
            f"enablement: {output or 'unknown'} (expected disabled)",
        )

    if profile == "server":
        code, output = runner(["systemctl", "is-enabled", "vegad.service"])
        check(
            "unit-vegad.service",
            code == 0 and output == "static",
            f"enablement: {output or 'unknown'} (expected static)",
        )
        activation_file = rooted(
            root, "/usr/share/dbus-1/system-services/org.lyraos.Vega1.service"
        )
        check(
            "vegad-dbus-service-file",
            activation_file.is_file(),
            str(activation_file),
        )
        code, output = runner(
            [
                "busctl",
                "--system",
                "call",
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "StartServiceByName",
                "su",
                "org.lyraos.Vega1",
                "0",
            ]
        )
        check(
            "vegad-dbus-activation",
            code == 0,
            output or "org.lyraos.Vega1 activation returned no detail",
        )

    if profile == "desktop":
        # No graphical session on the server profile at all
        # (docs/server-edition.md) - nothing to check a shell process for.
        code, output = runner(["pgrep", "-x", "xfce4-session"])
        check(
            "xfce4-session",
            code == 0 and bool(output),
            "XFCE session process is running",
        )
        observations["desktop"] = environment.get("XDG_CURRENT_DESKTOP", "")
        observations["session_type"] = environment.get("XDG_SESSION_TYPE", "")

    code, failed_units = runner(
        ["systemctl", "--failed", "--no-legend", "--plain"]
    )
    check(
        "failed-units",
        code == 0 and not failed_units,
        failed_units or "no failed system units",
    )
    code, critical_journal = privileged_command(
        [
            "journalctl",
            "-b",
            "-p",
            "0..3",
            "--no-pager",
            "--quiet",
            "--output=short-monotonic",
        ],
        runner=runner,
        required=privileged_access_required,
    )
    journal_passed = code == 0 and (
        not critical_journal or bool(journal_acknowledgement.strip())
    )
    check(
        "critical-journal",
        journal_passed,
        "empty"
        if not critical_journal
        else (
            "reviewed with explicit acknowledgement"
            if journal_acknowledgement.strip()
            else "critical entries require explicit acknowledgement"
        ),
    )
    observations["critical_journal"] = critical_journal.splitlines()
    observations["journal_acknowledgement"] = journal_acknowledgement.strip()
    observations["username"] = username

    return result("first-boot", checks, observations)


def validate_secure_boot(
    *, root: Path = Path("/"), runner: CommandRunner = run_command
) -> dict[str, object]:
    checks: list[dict[str, str]] = []
    observations: dict[str, object] = {}
    privileged_access_required = root.resolve() == Path("/")

    def check(identifier: str, passed: bool, detail: str) -> None:
        checks.append(
            {
                "id": identifier,
                "status": "passed" if passed else "failed",
                "detail": detail,
            }
        )

    efi_variables = rooted(root, "/sys/firmware/efi/efivars")
    check("uefi-boot", efi_variables.is_dir(), "EFI variables are available")
    code, mount_output = runner(["findmnt", "-n", "/boot/efi"])
    check(
        "efi-mounted",
        code == 0 and bool(mount_output),
        mount_output or "/boot/efi is not mounted",
    )
    code, secure_boot = runner(["mokutil", "--sb-state"])
    check(
        "secure-boot-enabled",
        code == 0 and "secureboot enabled" in secure_boot.casefold(),
        secure_boot or "mokutil did not report Secure Boot state",
    )
    fallback = rooted(root, "/boot/efi/EFI/BOOT/BOOTX64.EFI")
    fallback_exists, fallback_error = probe_system_path(
        fallback,
        kind="file",
        runner=runner,
        privileged_fallback=privileged_access_required,
    )
    check(
        "efi-fallback-loader",
        fallback_exists and not fallback_error,
        fallback_error or str(fallback),
    )
    observations["mokutil"] = secure_boot.splitlines()

    return result("uefi-secure-boot", checks, observations)


def write_report(report: dict[str, object], output: Path) -> None:
    output = output.resolve()
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=output.parent,
        prefix=f".{output.name}.",
        delete=False,
    ) as stream:
        json.dump(report, stream, indent=2, sort_keys=True, ensure_ascii=False)
        stream.write("\n")
        temporary = Path(stream.name)
    temporary.replace(output)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="mode", required=True)
    first_boot = commands.add_parser("first-boot")
    first_boot.add_argument(
        "--output", type=Path, default=Path("first-boot-result.json")
    )
    first_boot.add_argument(
        "--acknowledge-journal",
        default="",
        help="issue/workaround covering reviewed priority 0..3 journal entries",
    )
    first_boot.add_argument(
        "--profile",
        choices=sorted(EXPECTED_ROOT_FSTYPE),
        default="desktop",
        help="which KIWI profile was installed (default: desktop)",
    )
    secure_boot = commands.add_parser("secure-boot")
    secure_boot.add_argument(
        "--output", type=Path, default=Path("uefi-secure-boot-result.json")
    )
    args = parser.parse_args()

    if args.mode == "first-boot":
        report = validate_first_boot(
            journal_acknowledgement=args.acknowledge_journal,
            profile=args.profile,
        )
    else:
        report = validate_secure_boot()
    write_report(report, args.output)
    print(args.output)
    return 0 if report["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
